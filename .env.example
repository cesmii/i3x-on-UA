# Default settings for ./start.sh. On first run it is copied to .env (local, gitignored); edit .env, not this file.
# Ports, endpoints and which gateways run are configured in compare/gateways.yaml.

# --- plant simulation (OPC UA server; see docs/factory/SIMULATION.md) ---
SIM_SPEED=1          # simulated seconds per wall-clock second
SIM_SEED=42          # same seed = same plant behaviour
SIM_HISTORY=3600     # in-memory history per variable (values); 0 = off
SIM_FAULTS=          # quality faults, e.g. PT-902=BadNotConnected,DT-301=UncertainLastUsableValue

# --- our gateway: interpretation switches (docs/gateway/MAPPING.md), uncomment to change ---
# I3X_QUALITY=base             # detailed (Bad_NotConnected) | base (Bad)
# I3X_ENUMS=name               # number | name
# I3X_INT64=number             # string | number
# I3X_COMPONENTS_SHAPE=nested  # flat | nested
# I3X_SYNTHESIZE_FLOW=false    # FlowsTo/FedBy from Pumps ports

# --- start.sh behaviour ---
AUTO_START_DOCKER=1  # macOS: start Docker Desktop if a Docker gateway is enabled and Docker isn't running
