    LG5["Packaging machine (Machinery + PackML)"]:::machine
    LG6[/"Supply / utility / material in or out"/]:::util
    LG7["Future (not built yet)"]:::future
    LGa[" "]:::util
    LGb[" "]:::util
    LGc[" "]:::future
    LGd[" "]:::future
    LGe[" "]:::machine
    LGf[" "]:::machine
