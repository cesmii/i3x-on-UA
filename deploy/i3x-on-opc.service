# systemd unit: the whole i3x-on-OPC demo (plant + cesmii + i3x2ua + uns + front door :8084), read-only.
# Install: see deploy/README.md. Edit the three marked lines (User, WorkingDirectory, PATH) first.

[Unit]
Description=i3X over OPC UA demo (virtual beverage factory + i3X gateways)
Documentation=file:///opt/i3x-on-OPC/deploy/README.md
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
# EDIT: an unprivileged user in the `docker` group, and the checkout it owns
User=i3x
WorkingDirectory=/opt/i3x-on-OPC
# EDIT: put the directory holding `node` (Node 24) first; systemd doesn't load nvm/.bashrc
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
# Front door port (default 8084 from compare/gateways.yaml); change it here if 8084 is taken on this host
Environment=FRONT_DOOR_PORT=8084
# Public demo: refuse writes everywhere (front door) and in our gateway (also /info capabilities.update.current=false)
Environment=COMPARE_READ_ONLY=1
Environment=GATEWAY_READ_ONLY=1
# .env has inline comments, which systemd's EnvironmentFile would keep as part of the values, so source it with bash.
# `exec` keeps the launcher as the main PID, so systemd's stop signal reaches it.
ExecStart=/bin/bash -c 'set -a; [ -f .env ] && . ./.env; set +a; exec node --import tsx compare/src/launch.ts up'
# The launcher stops its children itself (process groups + `docker rm -f`): signal only it, SIGKILL the rest after the timeout.
KillMode=mixed
KillSignal=SIGINT
TimeoutStartSec=300
TimeoutStopSec=45
Restart=on-failure
RestartSec=10

# Light hardening (it writes only inside the checkout: compare/logs, server/pki)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
